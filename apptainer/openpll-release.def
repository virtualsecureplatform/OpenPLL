Bootstrap: localimage
From: build/apptainer/openpll-xyce-base.sif

%post
    cmake -S /opt/Xyce -B /opt/xyce-build \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_INSTALL_PREFIX=/opt/xyce \
        -D Trilinos_ROOT=/opt/trilinos \
        -D CMAKE_C_COMPILER=mpicc \
        -D CMAKE_CXX_COMPILER=mpicxx
    cmake --build /opt/xyce-build --parallel 8 --target install
    cmake --build /opt/xyce-build --parallel 8 --target xycecinterface
    /opt/xyce/bin/Xyce -v


%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/opt/xyce/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin:/opt/ciel-venv/bin
    export NIX_REMOTE=local
    export LIBRELANE_ROOT=/opt/librelane
    export CIEL_SKY130_ROOT=/opt/pdk/ciel/sky130
    export XYCE_MPI_ROOT=/opt/xyce
    export XYCE_MIXED_BUILD_DIR=/opt/xyce-build
    export OPENPLL_RELEASE_TAG=v8
    export OPENPLL_EXPECTED_LIBRELANE_COMMIT=0f39aab99009d4a81ee3f863f0da9ca2f0b43a99
    export OPENPLL_EXPECTED_CIEL_SKY130_VERSION=7519dfb04400f224f140749cda44ee7de6f5e095

%runscript
    set -eu
    if [ ! -x /work/OpenPLL/scripts/reproduce_latest_release.sh ]; then
        echo "OpenPLL is not mounted at /work/OpenPLL, or reproduce_latest_release.sh is not executable." >&2
        echo "Use scripts/apptainer_reproduce_latest_release.sh from the repository root." >&2
        exit 2
    fi
    cd /work/OpenPLL
    exec /work/OpenPLL/scripts/reproduce_latest_release.sh "$@"

%help
    This image includes the pinned Sky130 PDK, LibreLane/Nix closure, and upstream
    MPI Xyce 7.10.0. It does not include the project's experimental KLS solver.
    The repository wrapper binds only the OpenPLL checkout:

        scripts/apptainer_reproduce_latest_release.sh build
        scripts/apptainer_reproduce_latest_release.sh audit
        scripts/apptainer_reproduce_latest_release.sh rebuild

    See REPRODUCIBILITY.md for the exact scope and host prerequisites.
